#!/bin/sh

# ═══════════════════════════════════════════════════════
# Cambiar a "false" para desactivar este hook SIN BORRARLO
ENABLED=true
# ═══════════════════════════════════════════════════════

if [ "$ENABLED" != "true" ]; then
  exit 0
fi

# Archivos que cambiaron en el merge
CHANGED_FILES=$(git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD)

# Solo actuar si hubo cambios relacionados con Prisma
if echo "$CHANGED_FILES" | grep -Eq "^prisma/(schema\.prisma|migrations/)"; then

  echo ""
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║  📦 Se detectaron cambios relacionados con Prisma           ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
  echo ""

  # ────────────────────────────────────────────────────────────
  # Obtener APP_ENV y datos básicos de DATABASE_URL
  # ────────────────────────────────────────────────────────────

  DB_INFO=$(node -e "
    require('dotenv').config();

    try {
      const databaseUrl = process.env.DATABASE_URL;

      if (!databaseUrl) {
        process.exit(1);
      }

      const db = new URL(databaseUrl);

      const environment = process.env.APP_ENV || '';
      const host = db.hostname;
      const name = db.pathname.replace(/^\\//, '');

      console.log(environment + '|' + host + '|' + name);
    } catch (error) {
      process.exit(1);
    }
  ")

  if [ $? -ne 0 ] || [ -z "$DB_INFO" ]; then
    echo "❌ No se pudo leer APP_ENV o DATABASE_URL."
    echo "   No se realizará ninguna operación con la base de datos."
    echo ""
    exit 1
  fi

  APP_ENV=$(echo "$DB_INFO" | cut -d'|' -f1)
  DB_HOST=$(echo "$DB_INFO" | cut -d'|' -f2)
  DB_NAME=$(echo "$DB_INFO" | cut -d'|' -f3)

  echo "🔎 Entorno detectado:"
  echo "   APP_ENV: $APP_ENV"
  echo "   Host:    $DB_HOST"
  echo "   BD:      $DB_NAME"
  echo ""

  # ════════════════════════════════════════════════════════════
  # PRODUCCIÓN
  # ════════════════════════════════════════════════════════════

  if [ "$APP_ENV" = "production" ] || [ "$DB_NAME" = "compospetbd" ]; then

    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║  🛡️ ENTORNO DE PRODUCCIÓN DETECTADO                         ║"
    echo "╠══════════════════════════════════════════════════════════════╣"
    echo "║                                                              ║"
    echo "║  Las migraciones NO se aplicarán automáticamente.            ║"
    echo "║                                                              ║"
    echo "║  Para aplicarlas de forma controlada utiliza:                 ║"
    echo "║                                                              ║"
    echo "║      npx prisma migrate status                               ║"
    echo "║      npx prisma migrate deploy                               ║"
    echo "║                                                              ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo ""

    echo "🔄 Regenerando Prisma Client..."
    npx prisma generate

    if [ $? -ne 0 ]; then
      echo ""
      echo "❌ No se pudo regenerar Prisma Client."
      exit 1
    fi

    echo ""
    echo "✅ Prisma Client regenerado."
    echo "⚠️ Recuerda aplicar manualmente las migraciones pendientes."
    echo ""

    exit 0
  fi

  # ════════════════════════════════════════════════════════════
  # DESARROLLO LOCAL
  # ════════════════════════════════════════════════════════════

  if [ "$APP_ENV" != "development" ] ||
     [ "$DB_NAME" != "compospetbd_local" ] ||
     { [ "$DB_HOST" != "localhost" ] && [ "$DB_HOST" != "127.0.0.1" ]; }; then

    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║  🛑 CONFIGURACIÓN DE BD NO RECONOCIDA                       ║"
    echo "╠══════════════════════════════════════════════════════════════╣"
    echo "║                                                              ║"
    echo "║  Por seguridad no se aplicarán migraciones.                  ║"
    echo "║                                                              ║"
    echo "║  Desarrollo debe utilizar:                                   ║"
    echo "║    APP_ENV=development                                       ║"
    echo "║    BD=compospetbd_local                                      ║"
    echo "║    Host=localhost                                            ║"
    echo "║                                                              ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo ""

    exit 1
  fi

  echo "✅ Entorno local confirmado."
  echo ""
  echo "🔄 Aplicando migraciones pendientes..."
  echo ""

  # IMPORTANTE:
  # Aquí usamos deploy, NO dev.
  # Solo queremos aplicar migraciones que ya existen en Git.
  npx prisma migrate deploy

  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Hubo un problema al aplicar las migraciones."
    echo ""
    echo "   Revisa el estado con:"
    echo ""
    echo "      npx prisma migrate status"
    echo ""
    echo "   ⚠️ NO ejecutes migrate reset sin comprobar primero"
    echo "      qué base de datos tienes configurada."
    echo ""

    exit 1
  fi

  echo ""
  echo "🔄 Regenerando Prisma Client..."
  echo ""

  npx prisma generate

  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Las migraciones se aplicaron, pero Prisma Client"
    echo "   no pudo regenerarse."
    echo ""
    exit 1
  fi

  echo ""
  echo "✅ Migraciones aplicadas correctamente."
  echo "✅ Prisma Client regenerado correctamente."
  echo ""
fi

exit 0