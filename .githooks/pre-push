#!/bin/sh

# ═══════════════════════════════════════════════════════
# cambiar a "false" para desactivar este hook SIN BORRARLO
ENABLED=true
# ═══════════════════════════════════════════════════════

if [ "$ENABLED" != "true" ]; then
  exit 0
fi

# Obtener el remote y la URL
remote="$1"
url="$2"

# leer los rangos de commits que se van a pushear
while read local_ref local_oid remote_ref remote_oid; do
  # si es un branch nuevo (remote_oid es todo ceros), comparar contra main/master
  if [ "$remote_oid" = "0000000000000000000000000000000000000000" ]; then
    # Branch nuevo: preferimos develop como referencia
    if git rev-parse --verify origin/develop >/dev/null 2>&1; then
      base="origin/develop"
    elif git rev-parse --verify origin/main >/dev/null 2>&1; then
      base="origin/main"
    elif git rev-parse --verify origin/master >/dev/null 2>&1; then
      base="origin/master"
    else
      continue
    fi

    range="$base..$local_oid"
  else
    range="$remote_oid..$local_oid"
  fi

  # obtener archivos modificados en los commits que se van a pushear
  CHANGED_FILES=$(git diff --name-only "$range" 2>/dev/null)

  # ssi no se pudo obtener el diff (ej: primer push), skip
  if [ $? -ne 0 ]; then
    continue
  fi

  # verificar si se modificó schema.prisma
  SCHEMA_CHANGED=$(echo "$CHANGED_FILES" | grep -c "^prisma/schema.prisma$")

  # verificar si se crearon/modificaron archivos en prisma/migrations/
  MIGRATIONS_CHANGED=$(echo "$CHANGED_FILES" | grep -c "^prisma/migrations/")

  # ──────────────────────────────────────────────────────
  # Schema cambió pero no hay migration
  # ──────────────────────────────────────────────────────

  if [ "$SCHEMA_CHANGED" -gt 0 ] && [ "$MIGRATIONS_CHANGED" -eq 0 ]; then
    echo ""
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║  ❌ PUSH BLOQUEADO                                          ║"
    echo "╠══════════════════════════════════════════════════════════════╣"
    echo "║                                                              ║"
    echo "║  Modificaste prisma/schema.prisma pero no incluiste una      ║"
    echo "║  migración.                                                  ║"
    echo "║                                                              ║"
    echo "║  Primero verifica que tu .env apunte a:                      ║"
    echo "║                                                              ║"
    echo "║      APP_ENV=development                                     ║"
    echo "║      compospetbd_local                                       ║"
    echo "║                                                              ║"
    echo "║  Después crea la migración:                                  ║"
    echo "║                                                              ║"
    echo "║    npx prisma migrate dev --name descripcion_del_cambio      ║"
    echo "║                                                              ║"
    echo "║  Haz commit de prisma/migrations/ y vuelve a intentar.        ║"
    echo "║                                                              ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo ""

    exit 1
  fi

  # ──────────────────────────────────────────────────────
  # Validar Prisma si hubo cambios
  # ──────────────────────────────────────────────────────

  if [ "$SCHEMA_CHANGED" -gt 0 ] || [ "$MIGRATIONS_CHANGED" -gt 0 ]; then

    echo ""
    echo "🔍 Validando schema de Prisma..."
    echo ""

    npx prisma validate

    if [ $? -ne 0 ]; then
      echo ""
      echo "❌ El schema de Prisma no es válido."
      echo "   PUSH CANCELADO."
      echo ""

      exit 1
    fi

    echo "✅ Schema de Prisma válido."
  fi

done

exit 0
